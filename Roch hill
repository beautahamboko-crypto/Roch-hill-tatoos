<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>INKWELL TATTOO · modern tattoo studio</title>
  <!-- Google Fonts for a raw, artistic vibe -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <!-- Font Awesome for icons (free) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #0b0b0b;
      color: #e3e3e3;
      font-family: 'Inter', sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* textured, dark background */
    body::before {
      content: "";
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><filter id="noise"><feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="1" stitchTiles="stitch"/></filter><rect width="100" height="100" filter="url(%23noise)" opacity="0.03"/></svg>');
      pointer-events: none;
      z-index: 0;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
      z-index: 2;
    }

    /* ========== HEADER / NAV ========== */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 24px 0 16px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .logo {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2.6rem;
      letter-spacing: 4px;
      color: #ffffff;
      line-height: 1;
      text-shadow: 0 0 8px rgba(255, 255, 255, 0.1);
    }

    .logo span {
      color: #c92f2f; /* deep blood red */
      text-shadow: 0 0 12px #b71c1c;
    }

    .nav-links {
      display: flex;
      gap: 36px;
      align-items: center;
    }

    .nav-links a {
      color: #cfcfcf;
      text-decoration: none;
      font-weight: 500;
      font-size: 1rem;
      letter-spacing: 0.5px;
      transition: color 0.2s, transform 0.2s;
      border-bottom: 2px solid transparent;
      padding-bottom: 6px;
    }

    .nav-links a:hover {
      color: #ffffff;
      border-bottom-color: #c92f2f;
      transform: translateY(-1px);
    }

    .btn {
      display: inline-block;
      background-color: transparent;
      border: 1.5px solid #c92f2f;
      color: #ffffff;
      padding: 12px 28px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-size: 0.85rem;
      text-decoration: none;
      transition: background 0.25s, color 0.25s, border-color 0.25s, box-shadow 0.25s;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      border-radius: 0px; /* sharp edges */
    }

    .btn:hover {
      background-color: #c92f2f;
      border-color: #c92f2f;
      box-shadow: 0 0 20px rgba(201, 47, 47, 0.4);
      color: #ffffff;
    }

    .btn-outline-light {
      border-color: #5a5a5a;
      color: #eaeaea;
    }

    .btn-outline-light:hover {
      background-color: #ffffff;
      border-color: #ffffff;
      color: #0b0b0b;
      box-shadow: none;
    }

    /* ========== HERO ========== */
    .hero {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      padding: 60px 0 80px;
      gap: 40px;
    }

    .hero-content {
      flex: 1 1 400px;
    }

    .hero-content h1 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 5.2rem;
      line-height: 0.95;
      letter-spacing: 4px;
      margin-bottom: 20px;
      color: #f5f5f5;
      text-transform: uppercase;
      text-shadow: 0 0 20px rgba(0,0,0,0.8);
    }

    .hero-content h1 .accent {
      color: #c92f2f;
      display: block;
      font-size: 3.8rem;
      letter-spacing: 6px;
    }

    .hero-content p {
      font-size: 1.2rem;
      color: #b0b0b0;
      max-width: 500px;
      margin-bottom: 36px;
      border-left: 4px solid #c92f2f;
      padding-left: 20px;
      font-weight: 300;
    }

    .hero-cta {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
    }

    .hero-visual {
      flex: 1 1 360px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .ink-graphic {
      width: 100%;
      max-width: 380px;
      aspect-ratio: 1 / 1.1;
      background: radial-gradient(circle at 30% 20%, #2a1a1a, #050505);
      border: 2px solid #2a2a2a;
      border-radius: 0% 50% 0% 50%; /* organic shape */
      box-shadow: 30px 30px 0 rgba(201, 47, 47, 0.1), -10px -10px 30px rgba(0,0,0,0.8);
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      transform: rotate(2deg);
      transition: transform 0.4s ease;
    }

    .ink-graphic:hover {
      transform: rotate(0deg) scale(1.01);
    }

    .ink-graphic i {
      font-size: 10rem;
      color: #c92f2f;
      opacity: 0.9;
      text-shadow: 0 0 30px #b71c1c, 0 0 10px #ff4444;
      filter: drop-shadow(0 0 20px black);
    }

    .ink-graphic::after {
      content: "⚡";
      position: absolute;
      bottom: 20px;
      right: 30px;
      font-size: 4rem;
      color: #6e1e1e;
      opacity: 0.5;
      transform: rotate(15deg);
    }

    /* ========== SECTION TITLES ========== */
    .section-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 3.2rem;
      letter-spacing: 4px;
      margin-bottom: 28px;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .section-title span {
      color: #c92f2f;
    }

    .section-title::after {
      content: "";
      flex: 1;
      height: 2px;
      background: linear-gradient(90deg, #c92f2f, transparent);
      margin-left: 20px;
    }

    /* ========== ARTIST CARDS ========== */
    .artists-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 30px;
      margin: 40px 0 70px;
    }

    .artist-card {
      background: #121212;
      border: 1px solid #232323;
      padding: 28px 18px 22px;
      text-align: center;
      transition: border-color 0.25s, box-shadow 0.25s, transform 0.2s;
      border-radius: 2px;
    }

    .artist-card:hover {
      border-color: #c92f2f;
      box-shadow: 0 10px 30px -10px rgba(201, 47, 47, 0.2);
      transform: translateY(-4px);
    }

    .artist-avatar {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: #1e1e1e;
      margin: 0 auto 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      color: #c92f2f;
      border: 2px solid #2e2e2e;
    }

    .artist-card h3 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.8rem;
      letter-spacing: 2px;
      color: #ffffff;
      margin-bottom: 4px;
    }

    .artist-specialty {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #c92f2f;
      margin-bottom: 12px;
      font-weight: 600;
    }

    .artist-desc {
      color: #a0a0a0;
      font-size: 0.9rem;
      line-height: 1.5;
      font-weight: 300;
    }

    /* ========== GALLERY / STYLE ========== */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 18px;
      margin: 30px 0 60px;
    }

    .gallery-item {
      aspect-ratio: 1 / 1;
      background: #101010;
      border: 1px solid #2a2a2a;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.8rem;
      color: #3a2a2a;
      transition: 0.2s;
      position: relative;
      overflow: hidden;
    }

    .gallery-item i {
      color: #5e2e2e;
      transition: transform 0.3s, color 0.3s;
    }

    .gallery-item:hover {
      border-color: #c92f2f;
    }

    .gallery-item:hover i {
      color: #c92f2f;
      transform: scale(1.15);
    }

    /* ========== CONTACT / BOOKING ========== */
    .booking-section {
      background: #101010;
      border: 1px solid #222;
      padding: 50px 40px;
      margin: 60px 0 80px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 30px;
      position: relative;
      overflow: hidden;
    }

    .booking-section::before {
      content: "⚡";
      position: absolute;
      font-size: 180px;
      color: #1a1a1a;
      right: -20px;
      bottom: -60px;
      transform: rotate(15deg);
      pointer-events: none;
      z-index: 0;
    }

    .booking-text {
      position: relative;
      z-index: 2;
    }

    .booking-text h2 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2.8rem;
      letter-spacing: 3px;
      color: #ffffff;
      margin-bottom: 10px;
    }

    .booking-text p {
      color: #b0b0b0;
      max-width: 400px;
      font-weight: 300;
      font-size: 1.05rem;
    }

    .booking-cta {
      position: relative;
      z-index: 2;
    }

    /* ========== FOOTER ========== */
    footer {
      border-top: 1px solid #222;
      padding: 40px 0 30px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      color: #5a5a5a;
      font-size: 0.9rem;
      gap: 20px;
    }

    .footer-social {
      display: flex;
      gap: 20px;
    }

    .footer-social a {
      color: #7a7a7a;
      font-size: 1.3rem;
      transition: color 0.2s, transform 0.2s;
    }

    .footer-social a:hover {
      color: #c92f2f;
      transform: translateY(-3px);
    }

    .footer-address i {
      margin-right: 6px;
      color: #c92f2f;
    }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 900px) {
      .hero {
        padding: 40px 0 60px;
      }
      .hero-content h1 {
        font-size: 3.8rem;
      }
      .hero-content h1 .accent {
        font-size: 2.8rem;
      }
      .navbar {
        flex-direction: column;
        gap: 18px;
      }
      .nav-links {
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
      }
      .section-title {
        font-size: 2.5rem;
      }
      .booking-section {
        padding: 30px 24px;
      }
    }

    @media (max-width: 550px) {
      .hero-content h1 {
        font-size: 2.8rem;
        letter-spacing: 2px;
      }
      .hero-content h1 .accent {
        font-size: 2rem;
      }
      .hero-content p {
        font-size: 1rem;
      }
      .logo {
        font-size: 2rem;
      }
      .btn {
        padding: 10px 18px;
        font-size: 0.75rem;
      }
      .ink-graphic i {
        font-size: 6rem;
      }
      .booking-text h2 {
        font-size: 2.2rem;
      }
    }

    /* subtle scroll behavior */
    html {
      scroll-behavior: smooth;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- navigation -->
    <header class="navbar">
      <div class="logo">INK<span>WELL</span></div>
      <nav class="nav-links">
        <a href="#">Home</a>
        <a href="#">Artists</a>
        <a href="#">Styles</a>
        <a href="#">Booking</a>
      </nav>
      <a href="#" class="btn">Book now</a>
    </header>

    <!-- hero section -->
    <section class="hero">
      <div class="hero-content">
        <h1>BOLD. <span class="accent">DARK.</span> TIMELESS.</h1>
        <p>Custom ink that speaks louder than words. Walk-ins welcome, but legends book ahead.</p>
        <div class="hero-cta">
          <a href="#" class="btn">Get a quote</a>
          <a href="#" class="btn btn-outline-light">View gallery</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="ink-graphic">
          <i class="fas fa-pen-nib"></i>
        </div>
      </div>
    </section>

    <!-- artists -->
    <h2 class="section-title"><span>//</span> RESIDENT ARTISTS</h2>
    <div class="artists-grid">
      <div class="artist-card">
        <div class="artist-avatar"><i class="fas fa-skull"></i></div>
        <h3>Mia Vex</h3>
        <div class="artist-specialty">Blackwork / Neo-tribal</div>
        <p class="artist-desc">Bold lines, heavy contrast, and geometry that bites. 8 years of experience.</p>
      </div>
      <div class="artist-card">
        <div class="artist-avatar"><i class="fas fa-dragon"></i></div>
        <h3>Kael Rōnin</h3>
        <div class="artist-specialty">Irezumi / Japanese</div>
        <p class="artist-desc">Traditional tebori-inspired. Backpieces, sleeves, and mythology in ink.</p>
      </div>
      <div class="artist-card">
        <div class="artist-avatar"><i class="fas fa-feather-alt"></i></div>
        <h3>Luna Nyx</h3>
        <div class="artist-specialty">Fine line / black & grey</div>
        <p class="artist-desc">Delicate details and surreal imagery. Perfect for first-timers.</p>
      </div>
      <div class="artist-card">
        <div class="artist-avatar"><i class="fas fa-bolt"></i></div>
        <h3>Ash</h3>
        <div class="artist-specialty">Chicano / lettering</div>
        <p class="artist-desc">Script, old English, and street-style. Flawless typography.</p>
      </div>
    </div>

    <!-- gallery / styles -->
    <h2 class="section-title"><span>//</span> RECENT INK</h2>
    <div class="gallery-grid">
      <div class="gallery-item"><i class="fas fa-moon"></i></div>
      <div class="gallery-item"><i class="fas fa-skull-crossbones"></i></div>
      <div class="gallery-item"><i class="fas fa-snake"></i></div>
      <div class="gallery-item"><i class="fas fa-eye"></i></div>
      <div class="gallery-item"><i class="fas fa-rose"></i></div>
      <div class="gallery-item"><i class="fas fa-dagger"></i></div>
      <div class="gallery-item"><i class="fas fa-spider"></i></div>
      <div class="gallery-item"><i class="fas fa-hourglass-half"></i></div>
    </div>

    <!-- booking / contact -->
    <section class="booking-section">
      <div class="booking-text">
        <h2>READY FOR YOUR <span style="color:#c92f2f;">MARK?</span></h2>
        <p>Consultations are free. We take deposits to lock in your session. No egos, just great tattoos.</p>
      </div>
      <div class="booking-cta">
        <a href="#" class="btn" style="font-size:1rem; padding:16px 40px;">Book a consultation</a>
      </div>
    </section>

    <!-- footer -->
    <footer>
      <div class="footer-address">
        <i class="fas fa-map-pin"></i> 666 Ink Lane, Brooklyn, NY · <i class="fas fa-clock"></i> Tue–Sun 12pm–8pm
      </div>
      <div class="footer-social">
        <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
        <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
        <a href="#" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
      </div>
      <div class="footer-copy">
        © 2025 INKWELL TATTOO — ALL RIGHTS RESERVED
      </div>
    </footer>
  </div>
  <!-- subtle script for demo purpose (no real form) -->
  <script>
    // just a small interaction for demo: log a friendly message
    document.querySelectorAll('.btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        if(btn.getAttribute('href') === '#') {
          e.preventDefault();
          alert('🔥 This is a demo. In a real shop, you\'d be redirected to booking.');
        }
      });
    });
  </script>
</body>
</html>
